<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.0" 
             xmlns="https://jakarta.ee/xml/ns/persistence" 
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd">
    <persistence-unit name="my_persistence_unit" transaction-type="JTA">
        <jta-data-source>java:/PostgresDS</jta-data-source>
        <!-- Entités JPA -->
        <class>com.mycompany.smartfood.entity.Ingredient</class>
        <class>com.mycompany.smartfood.entity.MealPlan</class>
        <class>com.mycompany.smartfood.entity.Recipe</class>
        <class>com.mycompany.smartfood.entity.ShoppingItemEntity</class>
        <class>com.mycompany.smartfood.entity.RecipeComponent</class>
        <class>com.mycompany.smartfood.entity.WasteEntry</class>
        <properties>
            <!-- Création automatique drop-and-create -->
            <property name="jakarta.persistence.schema-generation.database.action" value="update"/>
            <!-- Dialecte PostgreSQL -->
            <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect"/>
            <!-- Log SQL -->
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>
